# ==============================================================================
# CoreRAG Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="CoreRAG Middleware"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Vector Database (Qdrant) Settings
# Options for QDRANT_MODE:
# - "memory"   : Volatile in-memory (best for unit tests)
# - "embedded" : Local directory persistence (zero Docker needed)
# - "server"   : Remote or Docker-based Qdrant server
QDRANT_MODE="embedded"
QDRANT_PATH="./data/qdrant"
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="corerag_knowledge_base"

# Embedding Provider Settings
# Options: "fast-mock" (zero download for instant testing), "sentence-transformers", "openai"
EMBEDDING_PROVIDER="fast-mock"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# LLM Synthesis Settings
# Options: "mock" (offline test answers), "openai", "litellm"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Default Demo Tenant API Keys (for local testing)
# Format: JSON mapping of API_KEY -> TENANT_ID
DEMO_API_KEYS='{"key_jiulibrary_secret_123": "jiulibrary", "key_staffportal_secret_456": "staff_portal"}'
